# PadungGo backend environment — copy to backend/.env; keep .env out of Git.

# --- Core ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Manila

# --- Database / spatial mode ---
# Local development (Windows/macOS without GDAL): use SQLite lite mode.
PADUNGGO_DB_ENGINE=sqlite
PADUNGGO_SQLITE_PATH=dev.sqlite3
# Production (Docker image on Render has GDAL/GEOS): postgis + Supabase Session pooler URI.
# Set these as Render environment variables, not in a committed file.
# Percent-encode special characters in the password (e.g. @ -> %40, # -> %23).
# PADUNGGO_DB_ENGINE=postgis
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- CORS / frontend ---
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# --- Production hardening (effective when DJANGO_DEBUG=False) ---
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_CSRF_TRUSTED_ORIGINS=https://your-frontend.example
# HSTS duration in seconds (default 300 = 5 minutes; raise gradually; 0 = off)
# DJANGO_SECURE_HSTS_SECONDS=300

# --- Admin bootstrap (optional; remove after first login) ---
# DJANGO_SUPERUSER_USERNAME=
# DJANGO_SUPERUSER_EMAIL=
# DJANGO_SUPERUSER_PASSWORD=
# One-off forgotten-password reset of an existing account:
# DJANGO_SUPERUSER_RESET_PASSWORD=True

# --- GTFS upload limits (optional overrides) ---
# GTFS_UPLOAD_MAX_MB=50
# GTFS_MAX_UNCOMPRESSED_MB=500

# --- Throttling (optional overrides) ---
# DRF_ANON_THROTTLE=120/min
# DRF_PLAN_THROTTLE=30/min
# DRF_PLACES_THROTTLE=40/min
# How many proxies append to X-Forwarded-For (finds the real visitor for the limits
# above). Defaults to 2 on Render (Cloudflare + Render) and 0 elsewhere. If limits
# seem not to apply, or everyone shares one limit, check this value.
# DRF_NUM_PROXIES=2

# --- Address labels and place suggestions (Geoapify, server-side only) ---
# Set the real key only in the Render dashboard. Never put it in a VITE_* variable.
# Without a key, addresses show "Selected location — address unavailable" and
# suggestions use PadungGo's own locations only.
GEOAPIFY_API_KEY=
# GEOAPIFY_DAILY_LIMIT=2500
# GEOAPIFY_SUGGEST_SHARE=0.8
# GEOAPIFY_TIMEOUT_SECONDS=4
# GEOAPIFY_SEARCH_RECT=123.70,10.15,124.10,10.50
# GEOAPIFY_MAX_ADDRESS_DISTANCE_M=100

# --- OpenStreetMap place import (Admin > Locations) ---
# Only if the public Overpass server must be swapped for another one.
# OVERPASS_URL=https://overpass-api.de/api/interpreter

# --- Planner (honest-data gating) ---
# Only `verified` records feed trusted journeys by default. Enable this ONLY for
# demos using real-but-historic GTFS data; the API/UI then show a clear
# "not field-verified" warning.
PLANNER_ALLOW_DOCUMENTED=False
PLANNER_STOP_RADIUS_M=500
PLANNER_WALK_SPEED_MPS=1.3

# --- Data import (Phase: GTFS importer) ---
# Free key from https://www.transit.land/ (optional; used by the GTFS fetch helper).
TRANSITLAND_API_KEY=

# --- AI trip explanation ("Explain this trip"; OpenAI-compatible endpoint) ---
# The submitted configuration is GroqCloud serving the open-weight model
# openai/gpt-oss-20b (Apache 2.0). Any OpenAI-compatible host of an open-weight
# model works, but the model MUST be open source / open weights.
# Set the real key only in the Render dashboard. Never put it in a VITE_* variable.
# Without all three of BASE_URL, API_KEY and MODEL the button says
# "unavailable" and the journey planner is unaffected.
# AI_BASE_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
# AI_TIMEOUT_SECONDS=10
# AI_MAX_OUTPUT_TOKENS=1200
# "low" keeps reasoning models fast; leave blank for hosts that reject the parameter.
# AI_REASONING_EFFORT=low
# Daily cap on provider calls (Groq's base limit for this model is 1,000/day).
# AI_DAILY_REQUEST_LIMIT=800
# AI_CACHE_SECONDS=86400
# Per-visitor limit on explanations:
# DRF_EXPLAIN_THROTTLE=6/min
